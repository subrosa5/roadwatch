FROM python:3.12-slim
WORKDIR /app
COPY collector/botkeep/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && useradd -u 10001 -m worker && mkdir /app/data && chown worker /app/data
COPY collector/collector.py collector/publisher.py collector/outbox.py collector/vehicles.py ./
COPY collector/botkeep/main.py collector/botkeep/config.json collector/botkeep/model.lock.json ./
COPY collector/vendor ./vendor
COPY collector/botkeep/vehicle.lock.json ./
USER worker
ENV ROADWATCH_MODE=preflight PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
CMD ["python", "main.py"]
